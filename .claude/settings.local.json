  "permissions": {
    "allow": [
      "Bash(python -c ' *)",
      "Bash(uv sync *)",
      "Bash(uv run python -c ' *)",
      "Bash(uv run *)",
      "Bash(DATABASE_URL=\"postgresql+asyncpg://u:p@localhost/offline_check\" uv run alembic upgrade head --sql)",
