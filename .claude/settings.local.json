      "Bash(TEST_DATABASE_URL=\"postgresql+asyncpg://u:p@127.0.0.1/chocofin_test\" uv run pytest -q tests/test_models_constraints.py)",
      "Bash(echo \"guard exit code: $?  \\(2 = hard abort, 0 would mean tests ran\\)\")"
    ]
  }
